{
  "manifest_version": 3,
  "name": "Google Meet Call Duration Timer",
  "version": "1.3.0",
  "description": "Displays the live call duration in Google Meet",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],,
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ]
}
