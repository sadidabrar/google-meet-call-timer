{
  "manifest_version": 3,
  "name": "Google Meet Tuition Companion",
  "version": "3.0.0",
  "description": "Enterprise Google Meet Tuition Companion: automated class timer, Drive/Sheets/Calendar auto-sync, Classroom Organizer, Homework Mailer, and Dual-Audio Presentation Recorder.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "notifications",
    "downloads"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://www.googleapis.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://drive.google.com/*",
    "https://docs.google.com/*",
    "https://calendar.google.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Google Meet Tuition Companion (v3.0.0)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
